{
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python manage.py test:*)",
      "Bash(python manage.py makemigrations --check:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python manage.py migrate:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/.env*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
