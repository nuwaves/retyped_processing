WHISPER_API_KEY=WHISPER_API_KEY
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_HOST=localhost
DB_NAME=audio_processing
GROQ_API_KEY=GROQ_API_KEY
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_TRANSCRIBE_OUTPUT_BUCKET=audio-processing-inputs-bucket
AWS_S3_BUCKET=audio-processing-inputs-bucket
SA_GOOGLE_OAUTH2_KEY=""
SA_GOOGLE_OAUTH2_SECRET=""
SA_FACEBOOK_LOGIN_KEY=""
SA_FACEBOOK_LOGIN_SECRET=""
SA_TWITTER_API_V2_KEY=""
SA_TWITTER_API_V2_SECRET=""
CORS_ALLOWED_ORIGINS="http://localhost:3000,"
# Leave unset to keep SQS. On the new server: redis://redis:6379/0
CELERY_BROKER_URL=
# Enables the shared Redis cache, e.g. redis://redis:6379/1
REDIS_URL=
# Set to the R2 endpoint (https://<account_id>.r2.cloudflarestorage.com) to store audio on R2
AWS_S3_ENDPOINT_URL=
AUDIO_CDN_URL=https://cdn.retyped.xyz
# Paid transcript API (x402), docs/paid-api.md. Keep both flags False until the
# owner approves launch and the transcript-rights question is settled.
PAID_API_ENABLED=False
PAID_API_RIGHTS_CLEARED=False
# Receiving address (public address only, never a private key). Testnet by default.
PAID_API_PAY_TO=
PAID_API_NETWORK=eip155:84532
PAID_API_PRICE_FETCH_USD=0.01
PAID_API_PRICE_SEARCH_USD=0.001
